    {
      "parameters": {
        "jsCode": "// Choisit les offres à envoyer : statut \"nouveau\", score >= SEUIL, triées par deadline puis score\nconst SEUIL = 6;   // note minimale (0-10)\nconst MAX = 5;     // nombre maximum d'offres par envoi\n\nconst norm = s => String(s ?? '').normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').trim().toLowerCase();\nconst get = (j, key) => { const k = Object.keys(j).find(x => norm(x) === key); return k ? String(j[k] ?? '').trim() : ''; };\nconst esc = s => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n\n// chat_id : reçu en entrée quand WF4 appelle ce sous-workflow, sinon lu dans le profil\nlet chatId = '';\ntry { chatId = String($('Appelé depuis Telegram').first().json.chat_id || ''); } catch (e) {}\nif (!chatId) {\n  for (const i of $('Lire profil').all()) {\n    if (get(i.json, 'cle') === 'chat_id') chatId = get(i.json, 'valeur');\n  }\n}\nif (!chatId) {\n  throw new Error(\"Aucun chat_id dans l'onglet profil : envoie /start à ton bot Telegram.\");\n}\n\nconst offres = $input.all().map(i => i.json)\n  .filter(j => get(j, 'id') && norm(get(j, 'statut')) === 'nouveau' && Number(get(j, 'score')) >= SEUIL)\n  .map(j => ({\n    id: get(j, 'id'), titre: get(j, 'titre'), entreprise: get(j, 'entreprise'),\n    lieu: get(j, 'lieu'), pays: get(j, 'pays'), remote: get(j, 'remote'),\n    type_contrat: get(j, 'type_contrat') || 'non précisé', duree: get(j, 'duree') || 'non précisée',\n    salaire: get(j, 'salaire') || 'non précisé', deadline: get(j, 'deadline'),\n    url: get(j, 'url'), resume: get(j, 'resume'), raison: get(j, 'raison'), score: Number(get(j, 'score'))\n  }))\n  .sort((a, b) => {\n    const da = a.deadline ? new Date(a.deadline).getTime() : Infinity;\n    const db = b.deadline ? new Date(b.deadline).getTime() : Infinity;\n    return (da - db) || (b.score - a.score);\n  })\n  .slice(0, MAX);\n\n// aucune offre : un seul item pour prévenir au lieu de rester silencieux\nif (!offres.length) return [{ json: { chat_id: chatId, nb: 0, aucune: true } }];\n\nconst dateFr = d => { const x = new Date(d); return isNaN(x) ? d : x.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long' }); };\n\nreturn offres.map(o => {\n  const lieu = [o.lieu, o.pays].filter(Boolean).filter((v, k, arr) => arr.indexOf(v) === k).join(', ') || 'non précisé';\n  const texte =\n    '<b>' + esc(o.titre) + '</b>\\n' + esc(o.entreprise) + '\\n\\n' +\n    '⭐ <b>' + o.score + '/10</b> · ' + esc(o.type_contrat) + '\\n' +\n    '📍 ' + esc(lieu) + (o.remote === 'oui' ? ' (remote)' : '') + '\\n' +\n    '⏱ ' + esc(o.duree) + ' · 💶 ' + esc(o.salaire) + '\\n' +\n    '📅 Deadline : ' + esc(o.deadline ? dateFr(o.deadline) : 'non précisée') + '\\n\\n' +\n    esc(o.resume) +\n    (o.raison ? '\\n\\n💡 <i>' + esc(o.raison) + '</i>' : '');\n  return { json: { ...o, chat_id: chatId, texte, nb: offres.length, aucune: false, url_ok: /^https?:\\/\\//.test(o.url) ? o.url : 'https://www.google.com/search?q=' + encodeURIComponent(o.titre + ' ' + o.entreprise) } };\n});"
      },
      "id": "1981a96b-a146-41e7-81b0-1b28ac882993",
      "name": "Choisir offres du jour",
