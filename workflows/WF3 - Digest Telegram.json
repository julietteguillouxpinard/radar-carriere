      "id": "cc895a83-b7e0-4072-9981-bd003badce51",
      "name": "Lire offres",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        480,
        112
      ],
      "executeOnce": true,
      "retryOnFail": true,
