        "jsCode": "const norm = s => String(s ?? '').normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').trim().toLowerCase();\nconst get = (j, key) => { const k = Object.keys(j).find(x => norm(x) === key); return k ? String(j[k] ?? '').trim() : ''; };\nlet chatId = '';\nfor (const i of $input.all()) if (get(i.json, 'cle') === 'chat_id') chatId = get(i.json, 'valeur');\nif (!chatId) return [];\nconst e = $('Quand un workflow échoue').first().json;\nconst texte = '⚠️ Le workflow « ' + (e.workflow?.name || '?') + ' » a échoué.\\n' +\n  'Nœud : ' + (e.execution?.lastNodeExecuted || '?') + '\\n' +\n  'Erreur : ' + String(e.execution?.error?.message || 'inconnue').slice(0, 400) + '\\n' +\n  'Exécution : ' + (e.execution?.url || ('n°' + (e.execution?.id || '?')));\nreturn [{ json: { chat_id: chatId, texte } }];"
      },
