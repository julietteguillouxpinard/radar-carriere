# Copy to .env and fill in. Never commit .env.

# n8n version: same as the demo instance (Help > About n8n). Never "latest".
N8N_VERSION=2.43.8

# PostgreSQL used by n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me
POSTGRES_DB=n8n

# Encrypts stored credentials. Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=change-me

# Public URL (the Telegram Trigger needs HTTPS: use a tunnel such as ngrok)
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
